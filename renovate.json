{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "Europe/Berlin",
  "baseBranchPatterns": ["develop"],
  "onboarding": false,
  "requireConfig": "optional",
  "enabledManagers": ["gomod", "npm", "dockerfile"],
  "labels": ["dependencies"],
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "postUpdateOptions": ["gomodTidy", "npmDedupe"],
  "platformAutomerge": true,
  "automerge": false,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": false,
    "minimumReleaseAge": null
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "Go-Abhängigkeiten (minor/patch)"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "npm-Abhängigkeiten (minor/patch)"
    },
    {
      "description": "Selbsttätig mergen nur Herausgeber mit belastbarem Release-Prozess (Trägerschaft Stufe 4-5, siehe docs/reference/dependencies.md). Alles andere braucht einen Menschenblick, auch Patches: ein Supply-Chain-Angriff kommt immer als neue Version.",
      "matchPackageNames": [
        "golang.org/x/**",
        "github.com/google/**",
        "github.com/gofiber/**",
        "github.com/golang-jwt/**",
        "github.com/eclipse/**",
        "gorm.io/**",
        "svelte",
        "vite",
        "@sveltejs/**",
        "@playwright/**",
        "bootstrap"
      ],
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "groupName": "Vertrauenswürdige Patch-Updates",
      "automerge": true
    },
    {
      "description": "Go-Toolchain: go-Zeile in go.mod und GO_IMAGE der CI immer gemeinsam. Ohne Wartezeit, Patch-Stände sind Sicherheitskorrekturen des Go-Teams.",
      "matchDepNames": ["go", "golang"],
      "matchDatasources": ["golang-version", "docker"],
      "rangeStrategy": "bump",
      "groupName": "Go-Toolchain",
      "minimumReleaseAge": null
    },
    {
      "description": "Go-Patch selbsttätig mergen, sobald die Pipeline grün ist. Die Runner frischen ihre Images täglich um 3 Uhr auf, vor diesem Lauf.",
      "matchDepNames": ["go", "golang"],
      "matchDatasources": ["golang-version", "docker"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Node.js der CI (NODE_IMAGE). Ein neuer Major kommt als eigener MR mit Menschenblick.",
      "matchDepNames": ["node"],
      "matchDatasources": ["docker"],
      "groupName": "Node.js"
    },
    {
      "description": "Playwright-Image und @playwright/test brauchen dieselbe Version, sonst fehlen im Image die passenden Browser.",
      "matchDepNames": ["mcr.microsoft.com/playwright", "@playwright/test"],
      "groupName": "Playwright"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Docker-Images in den *_IMAGE-Variablen der .gitlab-ci.yml (Go, Node, Playwright).",
      "managerFilePatterns": ["/^\\.gitlab-ci\\.yml$/"],
      "matchStrings": ["(?:^|\\n)[ \\t]*[A-Z_]+_IMAGE:[ \\t]+(?<depName>[^\\s:]+):(?<currentValue>[^\\s#]+)"],
      "datasourceTemplate": "docker"
    }
  ]
}
