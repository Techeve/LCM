[Unit]
# Description shows up in `systemctl status` and journal output. It is a
# static string that cannot follow the system language, so English is used -
# and plain ASCII, because service metadata travels through terminals and log
# pipelines whose encoding we do not control.
Description=LCM Remote Agent (connects this server outbound to the LCM server)
Documentation=https://gitlab.techeve.de/techeve/lcm
After=network-online.target
Wants=network-online.target
# Without enrollment (lcm-agent enroll <url> <token>) the service does not
# start - so the package can safely be pre-installed.
ConditionPathExists=/etc/lcm-agent/agent.json
# Never give up: after any number of crashes systemd keeps restarting the
# agent (the default would stop after 5 starts in 10 s). The agent is often the
# only way into the server. [Unit] key since systemd 230.
StartLimitIntervalSec=0

[Service]
# Watchdog: the agent arms it at runtime itself (sd_notify WATCHDOG_USEC=90s,
# systemd 236+) and feeds it (WATCHDOG=1) only while its connection loop makes
# progress. If it hangs, the feed stops and systemd restarts it.
# Deliberately no Type=notify and no WatchdogSec= here: on a package upgrade
# postinst reloads the units while the OLD agent still runs - possibly the very
# apt run installing this upgrade. A unit-level watchdog would kill that old,
# non-feeding agent and apt with it. Without systemd (OpenRC, manual run) the
# agent works the same, it just notifies no one.
Type=simple
NotifyAccess=main
# Not the binary itself but the guard script: it counts starts and falls back to
# the previous binary if a new one does not come up (packaging/lcm-agent-start.sh).
# It ends in exec, so the agent is the main process (same PID).
ExecStart=/usr/lib/lcm-agent/lcm-agent-start run
Restart=always
RestartSec=10
# KillMode stays at control-group, but the commands no longer belong to this
# group: the agent starts each one as its own transient scope (systemd-run
# --scope, probed once at first use) with output and exit code in
# /var/lib/lcm-agent/jobs. Stopping, restarting or crashing the agent leaves a
# running command alone; the next agent takes it over again. Only an explicit
# abort from LCM stops one. (If systemd-run cannot create a scope, commands
# run in the agent's own session instead and a stop does take them down.)
# The package scripts still never stop or restart the agent on an upgrade: it
# switches to a new binary by itself once it is idle (exec, same PID).
# The agent runs management commands from the LCM server as root (package
# management, Docker, firewall) - just like an SSH root session. Sandbox
# hardening as done for the lcm server is therefore not possible here.
User=root
# /run/lcm-agent holds status.json, which `lcm-agent status` reads. The agent
# rewrites it every 10 s; systemd creates the directory (root, 0755) and, with
# "restart", keeps it across automatic restarts, so the last known state of a
# crashed agent stays readable. It is removed on a real stop. An exec switch to
# a new binary keeps the process, so nothing happens to it. RuntimeDirectory= needs
# systemd 211, RuntimeDirectoryPreserve= 235 (Debian 11 has 247). The agent also
# creates the directory itself, which covers the first run after a package upgrade.
RuntimeDirectory=lcm-agent
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart

[Install]
WantedBy=multi-user.target
