[Unit]
# English and plain ASCII on purpose, see lcm-agent.service.
Description=LCM probe (host and database measurement for LCM)
Documentation=https://gitlab.techeve.de/techeve/lcm
# Deliberately independent of lcm.service: the probe must keep writing while
# LCM is stopped or hanging - those are the minutes it exists for.
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/lcm-probe run
Restart=always
RestartSec=5
# Runs as root, but with a single capability: reading files it does not own
# (the LCM certificate for the pinned HTTPS connection, the API key). It can
# write nowhere except its own state directory.
User=root
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StateDirectory=lcm-probe
StateDirectoryMode=0750
# Survive memory pressure longer than the services it observes.
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
