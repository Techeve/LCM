# Umgebung für docker-compose.yml - als .env kopieren und anpassen:
#
#   cp docker/.env.example docker/.env
#   sed -i "s/BITTE-ERSETZEN/$(openssl rand -hex 32)/" .env
#
# Das Token schützt den Trivy-Sidecar. Er führt Prozesse aus und lädt Images
# aus fremden Registries - ein offener Endpunkt dafür ist kein Zustand, den
# man versehentlich erreichen darf. Deshalb starten weder der Sidecar noch
# Compose ohne gesetztes Token, statt still ohne Schutz zu laufen.
#
# Beide Container bekommen denselben Wert. Stimmen sie nicht überein, weist
# der Sidecar jede Anfrage mit HTTP 401 ab - LCM sagt das dann im Klartext.
LCM_TRIVY_TOKEN=BITTE-ERSETZEN
